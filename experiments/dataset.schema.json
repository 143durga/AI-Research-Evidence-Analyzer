{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt variation study dataset record",
  "description": "One question and its fixed evidence context. Store one JSON object per line in a JSONL file.",
  "type": "object",
  "required": ["question_id", "paper_id", "paper_title", "authors", "year", "source", "source_url", "document_sha256", "question", "question_type", "answerability", "answerability_reason", "evidence"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "paper_id": {"type": "string", "minLength": 1},
    "paper_title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "year": {"type": "integer", "minimum": 1900},
    "source": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "doi": {"type": "string"},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question": {"type": "string", "minLength": 1},
    "question_type": {"enum": ["direct_factual", "synthesis", "cautious_qualified", "unanswerable"]},
    "answerability": {
      "type": "string",
      "enum": ["answerable", "unanswerable"],
      "description": "Human label indicating whether the fixed evidence context supports an answer."
    },
    "answerability_reason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "page", "text", "paper_title", "authors", "year", "source", "source_url", "doi", "document_sha256", "reason"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1},
          "paper_title": {"type": "string", "minLength": 1},
          "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "year": {"type": "integer", "minimum": 1900},
          "source": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "doi": {"type": "string"},
          "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}